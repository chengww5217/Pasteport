{
  "name": "pasteport",
  "displayName": "Pasteport",
  "description": "%extension.description%",
  "version": "0.0.2",
  "publisher": "chengww",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chengww5217/pasteport.git"
  },
  "bugs": {
    "url": "https://github.com/chengww5217/pasteport/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "dist/build/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "remote",
    "clipboard",
    "paste",
    "terminal",
    "ssh"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/build/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "pasteport.paste",
        "title": "%command.paste.title%",
        "category": "Pasteport"
      },
      {
        "command": "pasteport.cancelTransfer",
        "title": "%command.cancelTransfer.title%",
        "category": "Pasteport"
      },
      {
        "command": "pasteport.cleanUpRemoteFiles",
        "title": "%command.cleanUpRemoteFiles.title%",
        "category": "Pasteport"
      },
      {
        "command": "pasteport.diagnose",
        "title": "%command.diagnose.title%",
        "category": "Pasteport"
      },
      {
        "command": "pasteport.showRemoteDir",
        "title": "%command.showRemoteDir.title%",
        "category": "Pasteport"
      }
    ],
    "keybindings": [
      {
        "command": "pasteport.paste",
        "key": "cmd+v",
        "when": "terminalFocus && isMac"
      },
      {
        "command": "pasteport.paste",
        "key": "ctrl+v",
        "when": "terminalFocus && isWindows"
      },
      {
        "command": "pasteport.paste",
        "key": "ctrl+shift+v",
        "when": "terminalFocus && isLinux"
      }
    ],
    "configurationDefaults": {
      "terminal.integrated.commandsToSkipShell": [
        "pasteport.paste"
      ]
    },
    "configuration": {
      "title": "Pasteport",
      "properties": {
        "pasteport.remoteDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.remoteDir.description%"
        },
        "pasteport.quoting": {
          "type": "string",
          "enum": [
            "auto",
            "shell",
            "none"
          ],
          "enumDescriptions": [
            "%config.quoting.auto%",
            "%config.quoting.shell%",
            "%config.quoting.none%"
          ],
          "default": "auto",
          "description": "%config.quoting.description%"
        },
        "pasteport.trailingSpace": {
          "type": "boolean",
          "default": true,
          "description": "%config.trailingSpace.description%"
        },
        "pasteport.confirmAboveSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "%config.confirmAboveSeconds.description%"
        },
        "pasteport.ttlHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "markdownDescription": "%config.ttlHours.description%"
        },
        "pasteport.bracketedPaste": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.bracketedPaste.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "compile": "tsc -p ./",
    "watch": "node scripts/build.mjs --watch",
    "lint": "eslint src --ext ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "npm run compile && node --test \"dist/tsc/test/*.test.js\"",
    "package": "npm run build && cd dist/package && npx --yes @vscode/vsce package --no-dependencies -o ../"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "20.11.30",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  }
}
