.vscode/**
.github/**
assets/**
scripts/**
src/**

# dist/build/** is the only part of dist/ that ships: dist/tsc/ is the tsc output the
# tests run from, and the finished vsix is written into dist/ itself — without the line
# below, packaging twice would put the previous vsix inside the next one.
dist/tsc/**
dist/*.vsix
dist/build/**/*.map

# the packaged readme is dist/build/README.md (see --readme-path); excluding the original
# keeps it from colliding with the copy vsce adds as readme.md
README.md
dist/build/README.md

node_modules/**
.gitignore
.prettierignore
.eslintrc.json
.prettierrc.json
.editorconfig
tsconfig.json
CONTRIBUTING.md
CODE_OF_CONDUCT.md
*.vsix
